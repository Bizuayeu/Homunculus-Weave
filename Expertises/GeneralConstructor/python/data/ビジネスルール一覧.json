  "metadata": {
    "description": "データ項目ごとの取得方針（入力／判断／計算）の一覧。AI が Phase 1.1 で読む入口",
    "as_of": "2026-08-24",
    "source": "IMPLEMENTATION_PLAN Stage 3（2026-08-24 裁定）。実装は python/inference.py・pricing.py・calculator.py",
    "取得方針の語彙": {
      "入力": "マイソク・手入力・テーブル参照で与えられる",
      "判断": "決定論的な判定ルール。関数名を併記する（提案であって採用ではない）",
      "計算": "計算式は関数が SSoT。ここには関数名だけを書く"
    },
    "処理順序": [
      "1. マイソクから基本情報を読み取り",
      "2. 欠損は inference.defaults_for で提案し、利用者の確認を経て採用",
      "3. 施工面積を段階的に計算（共用部→地下緩和→最大施工面積→施工面積）",
      "4. ベース㎡単価（帯域＋道路・基礎形状・種別オフセット）を求める",
      "5. オプションを積み、最終㎡単価を確定",
      "6. 工事代金・建設経費・PJ総額（単価表が税込ゆえ税込）を算出",
      "7. 貸床面積から年間売上・表面利回を算出",
      "8. 表面利回を貸床単価テーブル上の目標利回と比較",
      "9. 建設上の留意点と投資判断をサマリとして出力"
    ],
    "備考": [
      "実効建蔽率：手入力の際は実効建蔽率70%超を許容",
      "共用部面積：各階の階段・EVホール等の容積対象外面積（8㎡＋EV面積）",
      "地下緩和面積：半地下の専有面積（容積緩和対象）",
      "最大施工面積：法令上建築可能な最大面積",
      "施工面積：実際の設計面積と法令上限の小さい方",
      "戸数：貸床面積が要るため、暫定計算 → estimate_units → 確認 → 再計算の順で決める"
    ],
    "notes": "v1 の metadata.計算式一覧は削除した（計算式の SSoT はコード。二重記述は乖離の芽）"
  }
}
